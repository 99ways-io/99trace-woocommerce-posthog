// 99trace.com: one Cloudflare Worker serving website/public, on the 99trace.com zone of the 99Ways account.
// Deploy from website/: npx wrangler@4.162.0 deploy   (preview locally: npx wrangler@4.162.0 dev)
{
  "name": "99trace-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "99trace.com", "custom_domain": true },
    { "pattern": "www.99trace.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
